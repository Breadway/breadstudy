# syntax=docker/dockerfile:1.7
# breadstudy-server, single image.
# Build:  docker build -t breadstudy:local -f packaging/Containerfile .

FROM docker.io/library/rust:1-bookworm AS build
WORKDIR /s
COPY Cargo.toml Cargo.lock ./
COPY server server
COPY migrations migrations
COPY spec spec
# Cache mounts keep dependency artifacts between builds. Without them every
# rebuild recompiles the full dependency tree in release mode.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/s/target \
    cargo build --release --locked -p breadstudy-server --bin breadstudy-server --bin seed && \
    cp /s/target/release/breadstudy-server /s/breadstudy-server && \
    cp /s/target/release/seed /s/breadstudy-seed

FROM docker.io/library/debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates python3 python3-sympy \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /s/breadstudy-server /usr/local/bin/breadstudy-server
COPY --from=build /s/breadstudy-seed /usr/local/bin/breadstudy-seed
COPY web /srv/breadstudy-web
ENV BREADSTUDY_LISTEN=0.0.0.0:7290 \
    BREADSTUDY_DATABASE_PATH=/var/lib/breadstudy/breadstudy.db \
    BREADSTUDY_WEB_DIR=/srv/breadstudy-web
VOLUME /var/lib/breadstudy
EXPOSE 7290
ENTRYPOINT ["breadstudy-server"]
